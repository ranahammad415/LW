# Database (MySQL) — local install example:
# DATABASE_URL="mysql://root:YOUR_PASSWORD@localhost:3306/localwaves"
# Replace YOUR_PASSWORD with the password you set for the MySQL root user during installation.
DATABASE_URL="mysql://user:password@localhost:3306/localwaves"

# JWT — required; each secret must be at least 32 characters (use long random strings in production)
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=your-access-secret-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Signed-cookie secret — MUST differ from the JWT secrets (min 32 chars)
COOKIE_SECRET=your-cookie-secret-min-32-chars

# Rate limiting (optional — defaults applied in code if unset)
# RATE_LIMIT_LOGIN_MAX=10
# RATE_LIMIT_LOGIN_WINDOW=15 minutes

# Trust proxy (set to true when behind nginx/Cloudflare so request.ip is correct)
# TRUST_PROXY=false

# Server
PORT=3000
NODE_ENV=development

# AI — Anthropic Claude Haiku
# Get your API key at https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key
# AI_MODEL=claude-haiku-4-5-20250514

# ── Nova voice (OpenAI Whisper STT + OpenAI TTS) ──
# Enables the mic + speaker buttons on the Nova client assistant.
# Uses the shared OPENAI_API_KEY below. Leave unset to disable voice features.
# OPENAI_API_KEY=your-openai-key
# OPENAI_TTS_VOICE=alloy            # alloy | echo | fable | onyx | nova | shimmer
# OPENAI_STT_MODEL=whisper-1
# OPENAI_TTS_MODEL=tts-1

# ── Nova chat rate limit (per user/ip) ──
# NOVA_RATE_LIMIT_MAX=10            # requests per window
# NOVA_RATE_LIMIT_WINDOW=60000      # window in ms (60_000 = 1 min)

# ── AI cost estimator (admin dashboard) ──
# USD per 1M tokens. Defaults are conservative Haiku estimates.
# AI_COST_PER_MTOK_IN=1.00
# AI_COST_PER_MTOK_OUT=5.00

# ──────────────────────────────────────────────────────────────────────────
# OmniSearch configuration
# ──────────────────────────────────────────────────────────────────────────
# OmniSearch is a large, self-contained sub-app that is HIDDEN by default to
# reduce product surface. Set to true to expose its API + /omni-search UI.
# The frontend has a matching flag: VITE_OMNISEARCH_ENABLED (frontend/.env).
# OMNISEARCH_ENABLED=false

# Override the Anthropic model used by every OmniSearch feature (default:
# claude-haiku-4-5-20250514). Keep empty to use the default.
# OMNISEARCH_AI_MODEL=claude-haiku-4-5-20250514

# ── SERP provider (rank-tracking / position-lookup) ──
# Allowed values: serpapi | dataforseo | none (default: none → Claude estimates)
 SERP_PROVIDER=dataforseo
# SERPAPI_API_KEY=your-serpapi-key

# ── Keyword data provider (volume / CPC / difficulty) ──
# Allowed values: dataforseo | none (default: none → Claude estimates)
 KEYWORD_DATA_PROVIDER=dataforseo

# ── Backlink provider ──
# Allowed values: dataforseo | majestic | ahrefs | none (default: none)
 BACKLINK_PROVIDER=dataforseo
# MAJESTIC_API_KEY=your-majestic-key
# AHREFS_API_KEY=your-ahrefs-key

# ── DataForSEO credentials (used by SERP / keyword / backlink providers) ──
# DATAFORSEO_LOGIN=your-email@example.com
# DATAFORSEO_PASSWORD=your-dataforseo-password

# ── AI Visibility (OpenRouter probes + DataForSEO LLM Mentions) ──
# OPENROUTER_API_KEY=sk-or-...
# Optional OpenRouter attribution headers / model overrides:
# OPENROUTER_SITE_URL=https://account.localwaves.ai
# OPENROUTER_APP_NAME=Localwaves
# OPENROUTER_MODEL_MAP={"chatgpt":"openai/gpt-4o-mini","claude":"anthropic/claude-3.5-haiku","gemini":"google/gemini-2.0-flash-001","perplexity":"perplexity/sonar"}

# ── GEO / AEO — real AI platform keys (otherwise Claude simulates) ──
# OPENAI_API_KEY=your-openai-key
# PERPLEXITY_API_KEY=your-perplexity-key
# GOOGLE_AI_API_KEY=your-google-generative-ai-key

# ── Sentry error reporting (optional) ──
# Leave SENTRY_DSN blank to disable. If set, install @sentry/node:
#   npm install --save @sentry/node
# SENTRY_DSN=https://public@sentry.example.com/1
# SENTRY_RELEASE=localwaves@1.0.0
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Google OAuth (for client Google Sign-In & agency analytics property linking)
# Create credentials at https://console.cloud.google.com/apis/credentials
# Enable APIs: Search Console, Google Analytics Admin, Google Analytics Data,
# Business Profile Account Management, Business Profile Business Information.
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# Agency connect callback (OWNER links one Google account for all clients):
# GOOGLE_AGENCY_REDIRECT_URI=http://localhost:3000/api/admin/integrations/google/callback
# Optional dedicated key for encrypting stored refresh tokens (defaults to JWT_ACCESS_SECRET):
# GOOGLE_TOKEN_ENCRYPTION_KEY=long-random-secret-at-least-32-chars
# FRONTEND_URL=http://localhost:5173
# API_PUBLIC_URL=http://localhost:3000
#
# IMPORTANT (production): set API_PUBLIC_URL and FRONTEND_URL to the public
# hostname, otherwise the Google OAuth callback falls back to localhost. e.g.:
#   API_PUBLIC_URL=https://account.localwaves.ai
#   FRONTEND_URL=https://account.localwaves.ai
#   GOOGLE_REDIRECT_URI=https://account.localwaves.ai/api/auth/google/callback
# Also add these to the OAuth client's Authorized redirect URIs in Google Cloud:
#   https://account.localwaves.ai/api/admin/integrations/google/callback
#   https://account.localwaves.ai/api/auth/google/callback

# ── Business Profile (GMB) data provider ──
# Allowed values: auto (default) | google | dataforseo
#   auto       — native Google when a location is bound & the API works,
#                DataForSEO (via gmbCid) otherwise.
#   google     — native Business Profile API only.
#   dataforseo — always use DataForSEO Business Data (public info + reviews).
# The native API needs a quota approval (default quota is 0); DataForSEO reuses
# the DATAFORSEO_LOGIN / DATAFORSEO_PASSWORD credentials below.
# BUSINESS_DATA_PROVIDER=auto
# Default DataForSEO location for GMB lookups (2840 = US; 2826 = UK):
# GMB_DFS_LOCATION_CODE=2840

# Google Search Console — Service Account key file path (fallback if agency OAuth not connected)
# Create a Service Account at https://console.cloud.google.com/iam-admin/serviceaccounts
# Enable Search Console API, download JSON key, and set the path here.
# Add the service account email as a user in each GSC property.
# GOOGLE_SERVICE_ACCOUNT_KEY=/path/to/service-account-key.json

# ── Scheduled task sync (Google Sheets → OS) ──
# Automates the previously-manual `npm run upload:phinix`. Runs in
# sync_progress mode so it updates status/comments for the current monthly
# session idempotently. Requires the Phinix sheets to be publicly readable.
# TASK_SYNC_ENABLED=false
# TASK_SYNC_CRON=0 2 * * *              # daily at 02:00 UTC (node-cron format)

# ── Content-review pipeline polling (safety net) ──
# Fallback that re-pulls the WordPress review pipeline in case a webhook is
# missed, and refreshes expired preview URLs. Enabled by default at 5 minutes
# when unset. Set to 0 to disable entirely.
# PIPELINE_SYNC_INTERVAL_MS=300000

# ── Pause notification emails (templates/prefs/SMTP config preserved) ──
# When true/1/yes/on: notify(), deferred emails, and notifyTest() skip SMTP.
# In-app alerts still work. Password-reset and Admin SMTP test still send.
# Post-deploy Content Reviews heal sequence:
#   1) NOTIFICATION_EMAILS_PAUSED=true  → restart API
#   2) Deploy OS + Localwave Agent 1.9.4+ on affected WP sites
#   3) Regenerate review links on Broaching / Great Lakes / P2EZPay items
#   4) Verify Team & Workload add/edit/remove
#   5) NOTIFICATION_EMAILS_PAUSED=false (or unset) → restart API
# NOTIFICATION_EMAILS_PAUSED=false
