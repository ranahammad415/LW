{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.localwaves.dev/agency-os-bridge/v1/pipeline-client-review.request.json",
  "title": "pipeline-client-review (reserved, Phase 2)",
  "description": "OWNER acting for the client.",
  "type": "object",
  "properties": {
    "reviewId": {
      "$ref": "common.json#/$defs/id"
    },
    "decision": {
      "$ref": "common.json#/$defs/clientDecision"
    },
    "comment": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 10000
        },
        {
          "type": "null"
        }
      ]
    },
    "actor": {
      "$ref": "common.json#/$defs/osActor"
    }
  },
  "required": [
    "reviewId",
    "decision",
    "actor"
  ]
}
