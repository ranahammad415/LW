{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.localwaves.dev/agency-os-bridge/v1/preview-link.response.json",
  "title": "preview-link response (v1.3.0)",
  "description": "",
  "type": "object",
  "properties": {
    "ok": {
      "const": true
    },
    "idempotentReplay": {
      "type": "boolean",
      "description": "v1.0.1: true on a response replayed from the idempotency store (EmDash strips the X-AOS-Idempotent-Replay header)"
    },
    "url": {
      "$ref": "common.json#/$defs/url"
    },
    "expiresAt": {
      "$ref": "common.json#/$defs/dateTime"
    },
    "editUrl": {
      "$ref": "common.json#/$defs/url"
    }
  },
  "required": [
    "ok",
    "url",
    "expiresAt",
    "editUrl"
  ]
}
