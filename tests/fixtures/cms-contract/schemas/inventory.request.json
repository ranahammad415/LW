{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.localwaves.dev/agency-os-bridge/v1/inventory.request.json",
  "title": "inventory",
  "description": "Paged list of entries in the bridged collections.",
  "type": "object",
  "properties": {
    "collection": {
      "$ref": "common.json#/$defs/collection"
    },
    "status": {
      "enum": [
        "draft",
        "published",
        "scheduled",
        "any"
      ]
    },
    "cursor": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 512
        },
        {
          "type": "null"
        }
      ]
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "since": {
      "$ref": "common.json#/$defs/dateTime"
    }
  },
  "required": []
}
