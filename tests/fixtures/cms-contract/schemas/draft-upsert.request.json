{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.localwaves.dev/agency-os-bridge/v1/draft-upsert.request.json",
  "title": "draft-upsert",
  "description": "Write a DRAFT (never publishes). Requires X-AOS-Idempotency-Key. A live entry gets a pending draft revision. Exactly one of layout / body / portableText.",
  "type": "object",
  "properties": {
    "target": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "entryId": {
              "$ref": "common.json#/$defs/id"
            }
          },
          "required": [
            "entryId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "collection": {
              "$ref": "common.json#/$defs/collection"
            },
            "slug": {
              "$ref": "common.json#/$defs/slug"
            },
            "parent": {
              "anyOf": [
                {
                  "$ref": "common.json#/$defs/id",
                  "description": "Parent SECTION: a value of the collection's parent select (e.g. spa-services) or an entry id of the same collection (its slug is used). Validated against the select options (422 SCHEMA_INVALID)"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "collection",
            "slug"
          ],
          "additionalProperties": false
        }
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "layout": {
      "type": "array",
      "items": {
        "$ref": "common.json#/$defs/block"
      },
      "maxItems": 24
    },
    "body": {
      "type": "object",
      "properties": {
        "markdown": {
          "type": "string",
          "maxLength": 200000
        }
      },
      "required": [
        "markdown"
      ]
    },
    "portableText": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "excerpt": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 1000
        },
        {
          "type": "null"
        }
      ]
    },
    "seo": {
      "$ref": "common.json#/$defs/seo",
      "description": "SEO panel values. v1.5.7 (§33.5): title, description, canonical (same-site path or same-origin URL; rewritten to the path) and noIndex are written; image is still ignored (SEO_FIELD_IGNORED). The SEO panel is not revisioned: on a published/scheduled entry seo.* is refused with warning SEO_LIVE_REFUSED (rest of the push applied) unless the site allows live SEO writes"
    },
    "fields": {
      "type": "object",
      "description": "Other collection fields by name (validated by the site)"
    },
    "seoExtras": {
      "type": "object",
      "description": "Opaque WP SEO extras (focus keyword, robots, OG) kept for the OS; not written by the bridge"
    },
    "baseRev": {
      "anyOf": [
        {
          "$ref": "common.json#/$defs/id",
          "description": "The rev from the last draft-upsert/entry-get; mismatch -> 409 CONFLICT_REV. v1.2.0: REQUIRED on updates of existing entries. v1.5.7 (§33.3): checked and written in one compare-and-set (capability atomicDraftUpdate)"
        },
        {
          "type": "null"
        }
      ]
    },
    "slug": {
      "$ref": "common.json#/$defs/slug",
      "description": "v1.2.0, updates only: new slug for a NEVER-PUBLISHED entry (live entry -> 409 SLUG_CHANGE_FORBIDDEN)"
    },
    "parent": {
      "anyOf": [
        {
          "$ref": "common.json#/$defs/id",
          "description": "v1.2.0, updates only: new parent section for a never-published entry"
        },
        {
          "type": "null"
        }
      ]
    },
    "slugPolicy": {
      "enum": [
        "exact",
        "best-effort"
      ],
      "description": "v1.2.0: exact (default with draftPushFromOs) = fail with SLUG_TAKEN/SERVICE_TOKEN_UNAVAILABLE rather than create another slug; best-effort = v1 behaviour (SLUG_MISMATCH warning)"
    },
    "bylines": {
      "type": "array",
      "items": {
        "$ref": "common.json#/$defs/slug"
      },
      "maxItems": 10,
      "uniqueItems": true,
      "description": "v1.2.0: byline slugs from site-info.bylines, in display order"
    },
    "taxonomies": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "common.json#/$defs/slug"
        },
        "maxItems": 50,
        "uniqueItems": true
      },
      "description": "v1.2.0: { taxonomyName: [termSlug] } from site-info.taxonomies; replaces the entry's terms for the named taxonomies only"
    },
    "actor": {
      "$ref": "common.json#/$defs/osActor"
    },
    "reviewAfter": {
      "type": "object",
      "properties": {
        "pm": {
          "$ref": "common.json#/$defs/member"
        },
        "note": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 10000
            },
            {
              "type": "null"
            }
          ]
        },
        "contentType": {
          "$ref": "common.json#/$defs/contentType"
        }
      },
      "required": [
        "pm"
      ]
    }
  },
  "required": [
    "target",
    "title",
    "actor"
  ],
  "oneOf": [
    {
      "required": [
        "layout"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "body"
            ]
          },
          {
            "required": [
              "portableText"
            ]
          }
        ]
      }
    },
    {
      "required": [
        "body"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "layout"
            ]
          },
          {
            "required": [
              "portableText"
            ]
          }
        ]
      }
    },
    {
      "required": [
        "portableText"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "layout"
            ]
          },
          {
            "required": [
              "body"
            ]
          }
        ]
      }
    }
  ]
}
