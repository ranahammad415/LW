{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.localwaves.dev/agency-os-bridge/v1/lead-erase.response.json",
  "title": "lead-erase response (v1.5.0)",
  "description": "",
  "type": "object",
  "properties": {
    "ok": {
      "const": true
    },
    "idempotentReplay": {
      "type": "boolean",
      "description": "v1.0.1: true on a response replayed from the idempotency store (EmDash strips the X-AOS-Idempotent-Replay header)"
    },
    "leadId": {
      "$ref": "common.json#/$defs/id"
    },
    "erased": {
      "type": "boolean"
    },
    "alreadyGone": {
      "type": "boolean"
    }
  },
  "required": [
    "ok",
    "leadId",
    "erased"
  ]
}
