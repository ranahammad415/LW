{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.localwaves.dev/agency-os-bridge/v1/security-history.response.json",
  "title": "security-history response (v1.6.0)",
  "description": "",
  "type": "object",
  "properties": {
    "ok": {
      "const": true
    },
    "idempotentReplay": {
      "type": "boolean",
      "description": "v1.0.1: true on a response replayed from the idempotency store (EmDash strips the X-AOS-Idempotent-Replay header)"
    },
    "points": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "overallState": {
            "enum": [
              "ok",
              "warn",
              "fail",
              "unknown"
            ]
          },
          "score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "checks": {
            "type": "object",
            "additionalProperties": {
              "enum": [
                "ok",
                "warn",
                "fail",
                "unknown"
              ]
            }
          }
        },
        "required": [
          "date",
          "overallState",
          "score"
        ]
      },
      "maxItems": 90
    }
  },
  "required": [
    "ok",
    "points"
  ]
}
