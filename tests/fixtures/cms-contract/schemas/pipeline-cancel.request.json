{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.localwaves.dev/agency-os-bridge/v1/pipeline-cancel.request.json",
  "title": "pipeline-cancel",
  "description": "Any active status -> cancelled (row kept). force=true allowed for OWNER only.",
  "type": "object",
  "properties": {
    "reviewId": {
      "$ref": "common.json#/$defs/id"
    },
    "force": {
      "type": "boolean",
      "description": "OWNER only (403 FORBIDDEN otherwise). Same transition as a normal cancel; marks an OWNER cancellation (OS tombstone)"
    },
    "reason": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 500
        },
        {
          "type": "null"
        }
      ]
    },
    "actor": {
      "$ref": "common.json#/$defs/osActor"
    },
    "expectedRev": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "reviewId",
    "actor"
  ]
}
