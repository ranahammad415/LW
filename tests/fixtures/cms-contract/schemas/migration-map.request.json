{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.localwaves.dev/agency-os-bridge/v1/migration-map.request.json",
  "title": "migration-map (v1.5.0)",
  "description": "Paged WordPress -> EmDash map of the migrated site.",
  "type": "object",
  "properties": {
    "cursor": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 512
        },
        {
          "type": "null"
        }
      ]
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500
    }
  },
  "required": []
}
