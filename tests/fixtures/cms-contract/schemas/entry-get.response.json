{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.localwaves.dev/agency-os-bridge/v1/entry-get.response.json",
  "title": "entry-get response",
  "description": "",
  "type": "object",
  "properties": {
    "ok": {
      "const": true
    },
    "idempotentReplay": {
      "type": "boolean",
      "description": "v1.0.1: true on a response replayed from the idempotency store (EmDash strips the X-AOS-Idempotent-Replay header)"
    },
    "entry": {
      "allOf": [
        {
          "$ref": "common.json#/$defs/entry"
        }
      ],
      "type": "object",
      "properties": {
        "variant": {
          "enum": [
            "draft",
            "live"
          ]
        },
        "h1": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 500
            },
            {
              "type": "null"
            }
          ]
        },
        "plainText": {
          "type": "string",
          "maxLength": 100000
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "href": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "internal": {
                "type": "boolean"
              }
            },
            "required": [
              "href"
            ]
          }
        },
        "images": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "src": {
                "type": "string"
              },
              "alt": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "src"
            ]
          }
        },
        "blocks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "type": {
                "type": "string"
              },
              "fields": {
                "type": "object",
                "description": "v1.1.0, only with includeFields: text values by field slug (string/text as strings, repeaters as arrays of objects, Portable Text as plain text). Never HTML"
              }
            },
            "required": [
              "type"
            ]
          }
        },
        "entryFields": {
          "type": "object",
          "description": "v1.1.0, only with includeFields: entry-level text fields (title, excerpt, seo.title, seo.description, posts body as plain text)"
        }
      },
      "required": [
        "variant",
        "plainText",
        "blocks"
      ],
      "not": {
        "properties": {
          "outlineOmitted": {
            "const": true
          }
        },
        "required": [
          "outlineOmitted"
        ]
      }
    }
  },
  "required": [
    "ok",
    "entry"
  ]
}
