{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.localwaves.dev/agency-os-bridge/v1/site-info.response.json",
  "title": "site-info response",
  "description": "Handshake body without keys, plus enabled blocks, installed plugins and counts.",
  "allOf": [
    {
      "$ref": "common.json#/$defs/siteInfo"
    }
  ],
  "type": "object",
  "properties": {
    "ok": {
      "const": true
    },
    "framework": {
      "type": "object",
      "properties": {
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "blocks": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "blockSchemas": {
          "type": "object",
          "additionalProperties": {
            "$ref": "common.json#/$defs/blockSchema"
          },
          "description": "v1.0.1: field definitions per enabled block (keys = blocks). Sites SHOULD send it; the OS builds and pre-checks layouts with it (checkLayout)."
        }
      },
      "required": [
        "blocks"
      ]
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id"
        ]
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "draft": {
            "type": "integer",
            "minimum": 0
          },
          "published": {
            "type": "integer",
            "minimum": 0
          },
          "scheduled": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": []
      }
    },
    "navigation": {
      "type": "array",
      "items": {
        "$ref": "common.json#/$defs/path"
      },
      "maxItems": 200,
      "uniqueItems": true,
      "description": "v1.0.7, optional: site-relative paths linked from the site template (top nav + footer), so the OS counts them as linked when computing orphans"
    },
    "sitemapUrl": {
      "$ref": "common.json#/$defs/url",
      "description": "v1.0.7, optional: absolute URL of the sitemap or sitemap index; the OS follows <sitemapindex> children"
    },
    "bylines": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slug": {
            "$ref": "common.json#/$defs/slug"
          },
          "name": {
            "type": "string",
            "maxLength": 200
          },
          "team": {
            "type": "boolean",
            "description": "the site's team byline (the only one agent-originated pushes get)"
          },
          "osUserId": {
            "anyOf": [
              {
                "$ref": "common.json#/$defs/uuid",
                "description": "the OS user this byline credits (mapped by a site admin); a human push may credit only their own"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "slug",
          "name"
        ]
      },
      "maxItems": 200,
      "description": "v1.2.0: existing bylines the OS may reference"
    },
    "taxonomies": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "maxLength": 100
          },
          "terms": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "slug": {
                  "$ref": "common.json#/$defs/slug"
                },
                "label": {
                  "type": "string",
                  "maxLength": 200
                }
              },
              "required": [
                "slug"
              ]
            },
            "maxItems": 500
          }
        },
        "required": [
          "terms"
        ]
      },
      "description": "v1.2.0: existing taxonomy terms by taxonomy name (the OS never creates terms)"
    },
    "media": {
      "$ref": "common.json#/$defs/mediaInfo"
    },
    "serviceToken": {
      "$ref": "common.json#/$defs/serviceTokenState",
      "description": "v1.5.4 (§30.1): state of the site-only service token (never the token itself); v1.5.5 (§31.1): also in the handshake/heartbeat body"
    },
    "migratedFrom": {
      "$ref": "common.json#/$defs/migratedFrom"
    },
    "leads": {
      "type": "object",
      "properties": {
        "forms": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 64
              },
              "name": {
                "type": "string",
                "maxLength": 200
              },
              "provider": {
                "enum": [
                  "emdash",
                  "ghl"
                ],
                "description": "v1.9.0 (§40), optional: emdash = the site's own form (the default when absent); ghl = an embedded GoHighLevel form"
              },
              "external": {
                "type": "boolean",
                "description": "v1.9.0 (§40), optional: a third party's form; its leads reach the OS from the provider (webhook), never as lead.created, and come back to the site only through lead-import"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        "siteRetentionDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 365
        }
      },
      "required": [],
      "description": "v1.5.0"
    },
    "mcp": {
      "type": "object",
      "properties": {
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "plugin": {
                "type": "string",
                "maxLength": 64
              },
              "name": {
                "type": "string",
                "maxLength": 100
              },
              "kind": {
                "enum": [
                  "read",
                  "propose",
                  "write-draft"
                ]
              }
            },
            "required": [
              "plugin",
              "name",
              "kind"
            ]
          },
          "maxItems": 100
        },
        "consentRequired": {
          "type": "boolean"
        }
      },
      "required": [
        "tools"
      ],
      "description": "v1.4.0: MCP tools agents may use on this site (never decide, lock, override or publish)"
    }
  },
  "required": [
    "ok",
    "framework",
    "plugins",
    "counts"
  ]
}
