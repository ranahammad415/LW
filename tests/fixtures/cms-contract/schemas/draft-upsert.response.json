{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.localwaves.dev/agency-os-bridge/v1/draft-upsert.response.json",
  "title": "draft-upsert response",
  "description": "warnings may include SLUG_MISMATCH {wanted, got} (Phase 1 cannot set a slug on create).",
  "type": "object",
  "properties": {
    "ok": {
      "const": true
    },
    "idempotentReplay": {
      "type": "boolean",
      "description": "v1.0.1: true on a response replayed from the idempotency store (EmDash strips the X-AOS-Idempotent-Replay header)"
    },
    "entryId": {
      "$ref": "common.json#/$defs/id"
    },
    "entryNo": {
      "$ref": "common.json#/$defs/surrogateNo"
    },
    "created": {
      "type": "boolean"
    },
    "draftRevisionId": {
      "$ref": "common.json#/$defs/id",
      "description": "EmDash draft revision id, or v<version> (e.g. v1) for a never-published entry whose main row is the draft. Opaque."
    },
    "rev": {
      "$ref": "common.json#/$defs/id",
      "description": "Opaque concurrency token: compare for equality only; send back as baseRev"
    },
    "path": {
      "$ref": "common.json#/$defs/path"
    },
    "editUrl": {
      "$ref": "common.json#/$defs/url"
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "common.json#/$defs/warning"
      }
    },
    "review": {
      "anyOf": [
        {
          "$ref": "common.json#/$defs/review"
        },
        {
          "type": "null"
        }
      ]
    },
    "slug": {
      "$ref": "common.json#/$defs/slug",
      "description": "v1.2.0: slug actually stored"
    },
    "parent": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 100
        },
        {
          "type": "null"
        }
      ]
    },
    "bylines": {
      "type": "array",
      "items": {
        "$ref": "common.json#/$defs/slug"
      }
    },
    "taxonomies": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "common.json#/$defs/slug"
        }
      }
    },
    "seoCheck": {
      "$ref": "common.json#/$defs/seoCheck"
    },
    "entry": {
      "$ref": "common.json#/$defs/entry",
      "description": "v1.2.0: the entry summary after the save (same shape as inventory)"
    }
  },
  "required": [
    "ok",
    "entryId",
    "entryNo",
    "created",
    "draftRevisionId",
    "rev",
    "path",
    "editUrl",
    "warnings"
  ]
}
