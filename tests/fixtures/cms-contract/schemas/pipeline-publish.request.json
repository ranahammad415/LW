{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.localwaves.dev/agency-os-bridge/v1/pipeline-publish.request.json",
  "title": "pipeline-publish (v1.3.0, allowOsPublish)",
  "description": "Publish the review's draft. Only when the site advertises publishFromOs (else 403 PUBLISH_NOT_ALLOWED). Human OWNER/PM only; client_approved required unless an OWNER override with a reason. The site runs the bridge gate and the emdash-seo publish gate (origin plugin).",
  "type": "object",
  "properties": {
    "reviewId": {
      "$ref": "common.json#/$defs/id"
    },
    "expectedRev": {
      "type": "integer",
      "minimum": 1
    },
    "actor": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "human"
        },
        "osUserId": {
          "$ref": "common.json#/$defs/uuid"
        },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "role": {
          "enum": [
            "OWNER",
            "PM"
          ]
        }
      },
      "required": [
        "kind",
        "osUserId",
        "name",
        "role"
      ]
    },
    "override": {
      "type": "boolean"
    },
    "overrideReason": {
      "type": "string",
      "minLength": 20,
      "maxLength": 1000
    }
  },
  "required": [
    "reviewId",
    "actor"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "override": {
            "const": true
          }
        },
        "required": [
          "override"
        ]
      },
      "then": {
        "required": [
          "overrideReason"
        ],
        "properties": {
          "actor": {
            "properties": {
              "role": {
                "const": "OWNER"
              }
            }
          }
        }
      }
    }
  ]
}
