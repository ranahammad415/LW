{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.localwaves.dev/agency-os-bridge/v1/review.response.json",
  "title": "Review response",
  "description": "Response of pipeline-get/submit/review/send-to-client/cancel/change-type.",
  "type": "object",
  "properties": {
    "ok": {
      "const": true
    },
    "idempotentReplay": {
      "type": "boolean",
      "description": "v1.0.1: true on a response replayed from the idempotency store (EmDash strips the X-AOS-Idempotent-Replay header)"
    },
    "review": {
      "$ref": "common.json#/$defs/review"
    }
  },
  "required": [
    "ok",
    "review"
  ]
}
