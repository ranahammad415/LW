{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.localwaves.dev/agency-os-bridge/v1/profile-upsert.request.json",
  "title": "profile-upsert (v1.4.0)",
  "description": "Push the OS-owned planning fields of an SEO profile (emdash-seo snake_case names). contract is applied only while unlocked. expectedProfileHash guards against overwriting site-side edits (409 CONFLICT_REV with the current profile -> OS drift row).",
  "type": "object",
  "properties": {
    "actor": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "human"
        },
        "osUserId": {
          "$ref": "common.json#/$defs/uuid"
        },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "role": {
          "enum": [
            "OWNER",
            "PM"
          ]
        }
      },
      "required": [
        "kind",
        "osUserId",
        "name",
        "role"
      ]
    },
    "expectedProfileHash": {
      "anyOf": [
        {
          "$ref": "common.json#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "profile": {
      "type": "object",
      "properties": {
        "page_id": {
          "$ref": "common.json#/$defs/pageId",
          "description": "v1.5.2: optional on create. Omitted -> the site resolves entry_id, then target (or path), to an existing profile, else creates one with the next site-issued id (P27 after P26) and returns it as page_id. An unknown OS-sent page_id creates the profile under that id (unchanged)"
        },
        "entry_id": {
          "anyOf": [
            {
              "$ref": "common.json#/$defs/id",
              "description": "v1.5.2: used to resolve an existing profile when page_id is omitted"
            },
            {
              "type": "null"
            }
          ]
        },
        "target": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "collection": {
          "$ref": "common.json#/$defs/collection"
        },
        "path": {
          "anyOf": [
            {
              "$ref": "common.json#/$defs/path"
            },
            {
              "type": "null"
            }
          ]
        },
        "page_type": {
          "type": "string",
          "maxLength": 64
        },
        "cluster": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "locality": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "parent_page_id": {
          "anyOf": [
            {
              "$ref": "common.json#/$defs/pageId"
            },
            {
              "type": "null"
            }
          ]
        },
        "working_title": {
          "type": "string",
          "maxLength": 300
        },
        "targeting": {
          "type": "object"
        },
        "contract": {
          "type": "object",
          "description": "applied only while the stored contract is unlocked"
        },
        "aeo": {
          "type": "object"
        },
        "facts": {
          "type": "object",
          "description": "facts.used[] (fact keys the page needs); status stays site-owned"
        },
        "links": {
          "type": "object"
        },
        "lifecycle": {
          "type": "object",
          "description": "OS may set publish_by, next_review_on; status is site-owned"
        },
        "research": {
          "type": "object"
        }
      },
      "required": []
    },
    "brief": {
      "type": "object",
      "properties": {
        "markdown": {
          "type": "string",
          "maxLength": 65536
        },
        "front_matter": {
          "type": "object"
        }
      },
      "required": [
        "markdown"
      ]
    }
  },
  "required": [
    "actor",
    "profile"
  ]
}
