{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.localwaves.dev/agency-os-bridge/v1/events-replay.request.json",
  "title": "events-replay",
  "description": "Return stored events with cursor > sinceCursor (gap healing after an OS outage). Events keep their original eventId, cursor and seq.",
  "type": "object",
  "properties": {
    "sinceCursor": {
      "type": "integer",
      "minimum": 0
    },
    "reviewId": {
      "$ref": "common.json#/$defs/id"
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500
    }
  },
  "required": [
    "sinceCursor"
  ]
}
