{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.localwaves.dev/agency-os-bridge/v1/events-replay.response.json",
  "title": "events-replay response",
  "description": "",
  "type": "object",
  "properties": {
    "ok": {
      "const": true
    },
    "idempotentReplay": {
      "type": "boolean",
      "description": "v1.0.1: true on a response replayed from the idempotency store (EmDash strips the X-AOS-Idempotent-Replay header)"
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "common.json#/$defs/event"
      }
    },
    "lastCursor": {
      "type": "integer",
      "minimum": 0
    },
    "more": {
      "type": "boolean"
    }
  },
  "required": [
    "ok",
    "events",
    "lastCursor",
    "more"
  ]
}
