// ============================================

// Searchable index of the markdown assets on disk under knowledge_base/{clientId}.
// Kept in sync by okfIndexingService.reindexOkfAssets.
model OkfAssetIndex {
  id           String   @id @default(uuid())
  clientId     String   @db.VarChar(255)
  filename     String   @db.VarChar(255)
  folder       String   @db.VarChar(255)
  relPath      String   @db.VarChar(500)
  title        String   @db.VarChar(255)
  type         String   @db.VarChar(100)
  sizeBytes    Int
  lastModified DateTime
  indexedAt    DateTime @default(now())

  @@index([clientId])
  @@map("okfassetindex")
}

// Append-only revision history for every OKF file write.
// Populated automatically by knowledgeEngine.writeOkfFile, deduplicated by contentHash.
model OkfVersion {
  id            String   @id @default(uuid())
  clientId      String   @db.VarChar(255)
  folder        String   @db.VarChar(255)
  filename      String   @db.VarChar(255)
  relPath       String   @db.VarChar(500)
  versionNumber Int      @default(1)
  contentHash   String   @db.VarChar(64)
  metadata      Json?
  body          String   @db.LongText
  authorId      String?  @db.VarChar(255)
  agentName     String?  @db.VarChar(255)
  changeSummary String?  @db.VarChar(500)
  createdAt     DateTime @default(now())

  @@index([clientId, relPath])
  @@map("okfversion")
}

model StrategyVersion {
  id            String   @id @default(uuid())
  projectId     String   @db.VarChar(255)
  versionNumber Int      @default(1)
  content       String   @db.LongText
  authorId      String   @db.VarChar(255)
  changeSummary String   @db.VarChar(500)
  createdAt     DateTime @default(now())

  @@index([projectId])
  @@map("strategyversion")
}

// ============================================
// Content Map / Topical Map Planner
// ============================================

model ContentMap {
  id                 String    @id @default(uuid())
  projectId          String
  name               String    @default("Content Map") @db.VarChar(255)
  status             String    @default("DRAFT") @db.VarChar(30) // DRAFT | IN_REVIEW | APPROVED | ARCHIVED
  clientVisible      Boolean   @default(false)
  clientDecision     String?   @db.VarChar(50) // APPROVED | CHANGES_REQUESTED
  clientDecisionAt   DateTime?
  clientDecisionById String?
  sections           Json?
  settings           Json?
  createdById        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now()) @updatedAt

  project          Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy        User?               @relation("ContentMapCreator", fields: [createdById], references: [id], onDelete: SetNull)
  clientDecisionBy User?               @relation("ContentMapDecisionBy", fields: [clientDecisionById], references: [id], onDelete: SetNull)
  nodes            ContentMapNode[]
  comments         ContentMapComment[]
  events           ContentMapEvent[]
  versions         ContentMapVersion[]
  syncState        ContentMapSync?
  drifts           ContentMapDrift[]

  @@index([projectId])
  @@map("contentmap")
}

model ContentMapNode {
  id                 String    @id @default(uuid())
  mapId              String
  parentId           String?
  kind               String    @db.VarChar(20) // ROOT | PILLAR | CLUSTER | PAGE
  name               String    @db.VarChar(500)
  slug               String?   @db.VarChar(500)
  priority           String?   @db.VarChar(10) // P1 | P2 | P3
  contentType        String?   @db.VarChar(100)
  intent             String?   @db.VarChar(100)
  accent             String?   @db.VarChar(50)
  note               String?   @db.LongText
  todo               String?   @db.LongText
  links              Json?
  isLive             Boolean   @default(false)
  needsFix           Boolean   @default(false)
  isSupport          Boolean   @default(false)
  sortOrder          Int       @default(0)
  posX               Float?
  posY               Float?
  collapsed          Boolean   @default(false)
  nodeStatus         String?   @db.VarChar(50)
  pmDecision         String?   @db.VarChar(50)
  clientDecision     String?   @db.VarChar(50)
  sitemapNodeId      String?
  taskId             String?
  /// Where this node came from: PLANNED | WORDPRESS | SITEMAP | PIPELINE
  source             String    @default("PLANNED") @db.VarChar(20)
  /// PLANNED | IN_PIPELINE | LIVE | NEEDS_UPDATE | ARCHIVED | GAP
  lifecycle          String    @default("PLANNED") @db.VarChar(20)
  wpPageId           String?
  wpContentReviewId  String?
  /// Resolved live URL once the node is mapped to real content.
  url                String?   @db.VarChar(500)
  pathDepth          Int?
  plannedPublishDate DateTime?
  publishedAt        DateTime?
  workCycleId        String?
  assigneeId         String?
  /// Target keywords: [{ keyword, keywordTrackId? }]
  keywords           Json?
  /// Cached enrichment snapshot (word count, links, SEO lengths, traffic).
  metrics            Json?
  metricsAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now()) @updatedAt

  map             ContentMap          @relation(fields: [mapId], references: [id], onDelete: Cascade)
  parent          ContentMapNode?     @relation("ContentMapNodeTree", fields: [parentId], references: [id], onDelete: Cascade)
  children        ContentMapNode[]    @relation("ContentMapNodeTree")
  comments        ContentMapComment[]
  events          ContentMapEvent[]
  drifts          ContentMapDrift[]
  sitemapNode     SitemapNode?        @relation(fields: [sitemapNodeId], references: [id], onDelete: SetNull)
  task            Task?               @relation(fields: [taskId], references: [id], onDelete: SetNull)
  wpPage          WpPage?             @relation(fields: [wpPageId], references: [id], onDelete: SetNull)
  wpContentReview WpContentReview?    @relation(fields: [wpContentReviewId], references: [id], onDelete: SetNull)
  workCycle       WorkCycle?          @relation(fields: [workCycleId], references: [id], onDelete: SetNull)
  assignee        User?               @relation("ContentMapNodeAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([mapId, parentId, sortOrder])
  @@index([mapId, slug])
  @@index([mapId, lifecycle])
  @@index([mapId, plannedPublishDate])
  @@index([wpPageId])
  @@map("contentmapnode")
}

/// Per-map WordPress sync state: when we last reconciled and with what result.
model ContentMapSync {
  id               String    @id @default(uuid())
  mapId            String    @unique
  lastSyncAt       DateTime?
  lastSyncStats    Json?
  /// Post types pulled into the map, e.g. ["page", "post"]. Null = all.
  includePostTypes Json?
  /// When true, new site content is adopted straight into the map instead of queued.
  autoAdopt        Boolean   @default(false)
  firstImportAt    DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt

  map ContentMap @relation(fields: [mapId], references: [id], onDelete: Cascade)

  @@map("contentmapsync")
}

/// Review queue for differences between the live WordPress site and the map.
/// Sync writes rows here rather than mutating the map behind the PM's back.
model ContentMapDrift {
  id           String    @id @default(uuid())
  mapId        String
  nodeId       String?
  wpPageId     String?
  /// NEW_CONTENT | REMOVED | URL_CHANGED | TITLE_CHANGED | STATUS_CHANGED | LIKELY_MATCH
  driftType    String    @db.VarChar(30)
  payload      Json?
  confidence   Float?
  /// PENDING | ADOPTED | MERGED | IGNORED
  status       String    @default("PENDING") @db.VarChar(20)
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  map        ContentMap      @relation(fields: [mapId], references: [id], onDelete: Cascade)
  node       ContentMapNode? @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  wpPage     WpPage?         @relation(fields: [wpPageId], references: [id], onDelete: Cascade)
  resolvedBy User?           @relation("ContentMapDriftResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([mapId, status, createdAt])
  @@index([mapId, driftType])
  @@map("contentmapdrift")
}

model ContentMapComment {
  id           String    @id @default(uuid())
  mapId        String
  nodeId       String?
  userId       String
  content      String    @db.LongText
  parentId     String?
  resolvedAt   DateTime?
  resolvedById String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  map        ContentMap          @relation(fields: [mapId], references: [id], onDelete: Cascade)
  node       ContentMapNode?     @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  user       User                @relation("ContentMapCommentAuthor", fields: [userId], references: [id], onDelete: Cascade)
  resolvedBy User?               @relation("ContentMapCommentResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  parent     ContentMapComment?  @relation("ContentMapCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies    ContentMapComment[] @relation("ContentMapCommentReplies")

  @@index([mapId, nodeId, createdAt])
  @@map("contentmapcomment")
}

model ContentMapEvent {
  id        String   @id @default(uuid())
  mapId     String
  nodeId    String?
  userId    String?
  eventType String   @db.VarChar(100)
  message   String?  @db.VarChar(500)
  metadata  Json?
  createdAt DateTime @default(now())

  map  ContentMap      @relation(fields: [mapId], references: [id], onDelete: Cascade)
  node ContentMapNode? @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  user User?           @relation("ContentMapEventActor", fields: [userId], references: [id], onDelete: SetNull)

  @@index([mapId, createdAt])
  @@map("contentmapevent")
}

model ContentMapVersion {
  id            String   @id @default(uuid())
  mapId         String
  versionNumber Int      @default(1)
  snapshot      Json
  authorId      String?
  changeSummary String   @db.VarChar(500)
  createdAt     DateTime @default(now())

  map    ContentMap @relation(fields: [mapId], references: [id], onDelete: Cascade)
  author User?      @relation("ContentMapVersionAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([mapId, versionNumber])
  @@map("contentmapversion")
}

// ============================================
// Realtime Voice Business Agent
// ============================================

// One spoken interview between a client and the Realtime voice agent.
// durationSeconds backs the per-client monthly minutes cap.
model VoiceInterviewSession {
  id              String    @id @default(uuid())
  clientId        String    @db.VarChar(255)
  projectId       String?   @db.VarChar(255)
  userId          String    @db.VarChar(255)
  /// VOICE for the realtime agent, TEXT for the AI-led expert interview.
  mode            String    @default("VOICE") @db.VarChar(20)
  status          String    @default("ACTIVE") @db.VarChar(30)
  startedAt       DateTime  @default(now())
  endedAt         DateTime?
  durationSeconds Int       @default(0)
  transcript      Json?
  extractedData   Json?
  /// The site + coverage review the AI was given before it asked anything.
  briefing        Json?
  summary         String?   @db.Text
  model           String?   @db.VarChar(100)
  createdAt       DateTime  @default(now())

  drafts OkfDraftChange[]

  @@index([clientId, startedAt])
  @@index([userId])
  @@index([clientId, mode, status])
  @@map("voiceinterviewsession")
}

// A proposed OKF write awaiting human approval. Nothing the voice agent or a
// gap interview produces reaches the knowledge base until one of these is
// approved by the SEO team.
model OkfDraftChange {
  id               String    @id @default(uuid())
  clientId         String    @db.VarChar(255)
  sessionId        String?
  folder           String    @db.VarChar(255)
  filename         String    @db.VarChar(255)
  title            String    @db.VarChar(255)
  proposedMetadata Json?
  proposedBody     String    @db.LongText
  sourceType       String    @default("VOICE_AGENT") @db.VarChar(40)
  confidence       Float?
  status           String    @default("PENDING") @db.VarChar(20)
  reviewerId       String?   @db.VarChar(255)
  reviewedAt       DateTime?
  reviewNote       String?   @db.VarChar(1000)
  createdAt        DateTime  @default(now())

  session VoiceInterviewSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([clientId, status])
  @@index([sessionId])
  @@map("okfdraftchange")
}

/// One attempt at seeding a client's knowledge base from their live website.
/// Progress is polled from this row; the extracted sections land in
/// OkfDraftChange so a human still approves everything before it is written.
model KnowledgeCrawlRun {
  id            String    @id @default(uuid())
  clientId      String    @db.VarChar(255)
  projectId     String?   @db.VarChar(255)
  rootUrl       String    @db.VarChar(1000)
  status        String    @default("PENDING") @db.VarChar(30)
  triggeredById String?   @db.VarChar(255)
  startedAt     DateTime?
  finishedAt    DateTime?
  pagesCrawled  Int       @default(0)
  draftsCreated Int       @default(0)
  error         String?   @db.VarChar(1000)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  @@index([clientId, createdAt])
  @@index([status])
  @@map("knowledgecrawlrun")
}

/// A one-off link that lets a client run a knowledge interview without signing
/// in. Only the sha256 of the token is stored; the plaintext is shown to the
/// admin once at creation.
model KnowledgeInterviewInvite {
  id            String    @id @default(uuid())
  clientId      String    @db.VarChar(255)
  projectId     String?   @db.VarChar(255)
  tokenHash     String    @unique @db.VarChar(64)
  createdById   String?   @db.VarChar(255)
  recipientName String?   @db.VarChar(255)
  sentToEmail   String?   @db.VarChar(255)
  status        String    @default("PENDING") @db.VarChar(20)
  expiresAt     DateTime
  lastOpenedAt  DateTime?
  completedAt   DateTime?
  revokedAt     DateTime?
  draftData     Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  @@index([clientId, createdAt])
  @@index([expiresAt])
  @@map("knowledgeinterviewinvite")
}

// ============================================
// OmniSearch Tool Models
// ============================================

model OmniSearchProject {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(255)
  domain      String   @db.VarChar(500)
  description String?  @db.Text
  settings    String?  @db.LongText // JSON config
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  keywords        OmniSearchKeyword[]
  contentSessions OmniSearchContentSession[]
  audits          OmniSearchAudit[]
  backlinks       OmniSearchBacklink[]
  geoPrompts      OmniSearchGeoPrompt[]
  localCitations  OmniSearchLocalCitation[]
  reports         OmniSearchReport[]
  automationTasks OmniSearchAutomationTask[]
  outreaches      OmniSearchOutreach[]

  @@index([domain])
  @@index([createdAt])
}

model OmniSearchKeyword {
  id           Int      @id @default(autoincrement())
  projectId    Int
  keyword      String   @db.VarChar(500)
  volume       Int? // monthly search volume
  difficulty   Float? // keyword difficulty 0-100
  cpc          Float? // cost per click
  serpFeatures String?  @db.Text // JSON array of SERP features
  country      String   @default("US") @db.VarChar(10)
  intent       String?  @db.VarChar(50) // informational, transactional, navigational, commercial
  isTracked    Boolean  @default(false)
  clusterId    Int?
  dataSource   String   @default("claude_estimated") @db.VarChar(50) // dataforseo | serpapi | gsc | claude_estimated
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project     OmniSearchProject         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  cluster     OmniSearchKeywordCluster? @relation(fields: [clusterId], references: [id], onDelete: SetNull)
  rankHistory OmniSearchRankHistory[]

  @@index([projectId])
  @@index([keyword])
  @@index([clusterId])
  @@index([createdAt])
}

model OmniSearchKeywordCluster {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(255)
  theme     String?  @db.VarChar(500) // cluster topic/theme
  projectId Int
  createdAt DateTime @default(now())

  keywords OmniSearchKeyword[]

  @@index([projectId])
}

model OmniSearchRankHistory {
  id           Int      @id @default(autoincrement())
  keywordId    Int
  position     Int? // null = not ranking
  url          String?  @db.VarChar(500) // ranking URL
  engine       String   @default("google") @db.VarChar(50) // google, bing, yahoo, etc.
  device       String   @default("desktop") @db.VarChar(20)
  location     String?  @db.VarChar(100)
  serpFeatures String?  @db.Text // JSON: which SERP features appear
  dataSource   String   @default("claude_estimated") @db.VarChar(50) // serpapi | dataforseo | gsc | claude_estimated
  checkedAt    DateTime @default(now())

  keyword OmniSearchKeyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@index([keywordId])
  @@index([checkedAt])
  @@index([keywordId, checkedAt])
}

model OmniSearchContentSession {
  id               Int      @id @default(autoincrement())
  projectId        Int
  targetKeyword    String   @db.VarChar(500)
  title            String?  @db.VarChar(500)
  content          String?  @db.LongText
  htmlContent      String?  @db.LongText
  nlpScore         Float? // overall content score 0-100
  wordCount        Int?
  readabilityScore Float? // Flesch-Kincaid or similar
  termData         String?  @db.LongText // JSON: recommended terms + usage counts
  serpData         String?  @db.LongText // JSON: top SERP competitors analysis
  status           String   @default("draft") @db.VarChar(50) // draft, optimizing, published
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  project  OmniSearchProject          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  articles OmniSearchArticle[]
  versions OmniSearchContentVersion[]

  @@index([projectId])
  @@index([createdAt])
}

model OmniSearchArticle {
  id              Int      @id @default(autoincrement())
  sessionId       Int?
  projectId       Int?
  topic           String   @db.VarChar(500)
  title           String?  @db.VarChar(500)
  content         String   @db.LongText
  outline         String?  @db.LongText // JSON: article outline/structure
  metaDescription String?  @db.VarChar(500)
  model           String?  @db.VarChar(100) // which AI model generated
  wordCount       Int?
  type            String   @default("article") @db.VarChar(50) // article, outline, rewrite, humanized
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  session OmniSearchContentSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@index([createdAt])
}

model OmniSearchAudit {
  id           Int       @id @default(autoincrement())
  projectId    Int
  url          String    @db.VarChar(500) // root URL audited
  status       String    @default("pending") @db.VarChar(50) // pending, crawling, analyzing, completed, failed
  pagesScanned Int       @default(0)
  issueCount   Int       @default(0)
  healthScore  Float? // 0-100 site health
  summary      String?   @db.LongText // JSON: audit summary
  settings     String?   @db.Text // JSON: audit configuration
  completedAt  DateTime?
  createdAt    DateTime  @default(now())

  project OmniSearchProject       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues  OmniSearchAuditIssue[]
  pages   OmniSearchCrawledPage[]

  @@index([projectId])
  @@index([createdAt])
}

model OmniSearchAuditIssue {
  id          Int      @id @default(autoincrement())
  auditId     Int
  type        String   @db.VarChar(100) // missing_title, duplicate_meta, broken_link, etc.
  severity    String   @db.VarChar(20) // critical, warning, info
  url         String   @db.VarChar(500)
  description String   @db.Text
  suggestion  String?  @db.Text
  createdAt   DateTime @default(now())

  audit OmniSearchAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId])
  @@index([severity])
  @@index([type])
}

model OmniSearchCrawledPage {
  id            Int      @id @default(autoincrement())
  auditId       Int
  url           String   @db.VarChar(500)
  statusCode    Int?
  title         String?  @db.VarChar(500)
  metaDesc      String?  @db.VarChar(500)
  h1            String?  @db.VarChar(500)
  canonical     String?  @db.VarChar(500)
  wordCount     Int?
  loadTime      Float? // seconds
  contentType   String?  @db.VarChar(100)
  internalLinks Int?
  externalLinks Int?
  images        Int?
  indexable     Boolean  @default(true)
  crawledAt     DateTime @default(now())

  audit OmniSearchAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId])
  @@index([url])
}

model OmniSearchBacklink {
  id           Int      @id @default(autoincrement())
  projectId    Int
  sourceUrl    String   @db.VarChar(500)
  sourceDomain String   @db.VarChar(255)
  targetUrl    String   @db.VarChar(500)
  anchorText   String?  @db.VarChar(500)
  domainRating Float? // 0-100
  trustFlow    Float? // 0-100
  citationFlow Float? // 0-100
  spamScore    Float? // 0-100 higher = more toxic (for disavow auto-detect)
  isDoFollow   Boolean  @default(true)
  isActive     Boolean  @default(true)
  dataSource   String   @default("claude_estimated") @db.VarChar(50) // dataforseo | majestic | ahrefs | claude_estimated
  firstSeen    DateTime @default(now())
  lastSeen     DateTime @default(now())

  project OmniSearchProject       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  disavow OmniSearchDisavowEntry?

  @@index([projectId])
  @@index([sourceDomain])
  @@index([firstSeen])
}

model OmniSearchDisavowEntry {
  id         Int      @id @default(autoincrement())
  backlinkId Int      @unique
  reason     String   @db.VarChar(500)
  status     String   @default("flagged") @db.VarChar(50) // flagged, exported, submitted
  scope      String   @default("domain") @db.VarChar(10) // domain | url
  createdAt  DateTime @default(now())

  backlink OmniSearchBacklink @relation(fields: [backlinkId], references: [id], onDelete: Cascade)

  @@index([status])
}

model OmniSearchGeoPrompt {
  id        Int      @id @default(autoincrement())
  projectId Int
  prompt    String   @db.Text
  platform  String   @db.VarChar(50) // chatgpt, perplexity, gemini, claude, copilot, grok, meta_ai, deepseek
  frequency String   @default("daily") @db.VarChar(20) // hourly, daily, weekly
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   OmniSearchProject       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  responses OmniSearchGeoResponse[]

  @@index([projectId])
  @@index([platform])
}

model OmniSearchGeoResponse {
  id                   Int      @id @default(autoincrement())
  promptId             Int
  platform             String   @db.VarChar(50)
  response             String   @db.LongText
  brandMentioned       Boolean  @default(false)
  sentiment            String?  @db.VarChar(20) // positive, neutral, negative
  citationUrl          String?  @db.VarChar(500)
  citationRank         Int? // position in citation list
  competitorsMentioned String?  @db.Text // JSON array
  entityAccuracy       Float? // 0-100 how accurately the AI describes the brand
  country              String?  @db.VarChar(10) // ISO-2 country code for regional GEO breakdown
  responseSource       String   @default("simulated") @db.VarChar(50) // simulated | real_chatgpt | real_perplexity | real_gemini | real_claude | real_openai
  checkedAt            DateTime @default(now())

  prompt OmniSearchGeoPrompt @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@index([promptId])
  @@index([platform])
  @@index([checkedAt])
}

model OmniSearchLocalCitation {
  id             Int      @id @default(autoincrement())
  projectId      Int
  platform       String   @db.VarChar(100) // google_business, yelp, facebook, apple_maps, etc.
  listingUrl     String?  @db.VarChar(500)
  businessName   String?  @db.VarChar(255)
  address        String?  @db.Text
  phone          String?  @db.VarChar(50)
  napConsistency Boolean  @default(true) // Name-Address-Phone consistent
  rating         Float?
  reviewCount    Int?
  isVerified     Boolean  @default(false)
  lastChecked    DateTime @default(now())
  createdAt      DateTime @default(now())

  project OmniSearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([platform])
}

model OmniSearchReport {
  id        Int       @id @default(autoincrement())
  projectId Int
  type      String    @db.VarChar(50) // seo_overview, rank_report, content_report, geo_report, backlink_report, full_report
  title     String    @db.VarChar(255)
  data      String    @db.LongText // JSON report data
  period    String    @db.VarChar(50) // weekly, monthly, quarterly, custom
  startDate DateTime?
  endDate   DateTime?
  format    String    @default("json") @db.VarChar(20) // json, pdf, csv
  createdAt DateTime  @default(now())

  project OmniSearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([type])
  @@index([createdAt])
}

model OmniSearchAutomationTask {
  id         Int       @id @default(autoincrement())
  projectId  Int
  type       String    @db.VarChar(100) // content_refresh, rank_check, geo_monitor, audit_schedule, link_prospect, content_publish
  name       String    @db.VarChar(255)
  config     String    @db.LongText // JSON task configuration
  status     String    @default("active") @db.VarChar(50) // active, paused, completed, failed
  schedule   String?   @db.VarChar(100) // cron expression or interval
  lastRun    DateTime?
  nextRun    DateTime?
  runCount   Int       @default(0)
  lastResult String?   @db.Text // JSON: last execution result
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  project OmniSearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
  @@index([nextRun])
}

model OmniSearchOutreach {
  id           Int       @id @default(autoincrement())
  projectId    Int
  targetDomain String    @db.VarChar(255)
  targetUrl    String?   @db.VarChar(500)
  contactName  String?   @db.VarChar(255)
  contactEmail String?   @db.VarChar(255)
  status       String    @default("prospect") @db.VarChar(50) // prospect, contacted, replied, negotiating, secured, rejected
  domainRating Float?
  emailSubject String?   @db.VarChar(500)
  emailBody    String?   @db.LongText
  notes        String?   @db.Text
  sentAt       DateTime?
  repliedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  project OmniSearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
  @@index([targetDomain])
}

model OmniSearchContentVersion {
  id            Int      @id @default(autoincrement())
  sessionId     Int
  versionNumber Int      @default(1)
  content       String   @db.LongText
  score         Float?
  wordCount     Int?
  semanticGrade String?  @db.VarChar(5) // A+, A, B, C, D, F
  savedBy       String?  @db.VarChar(255) // user identifier
  changeNote    String?  @db.VarChar(500) // description of changes
  savedAt       DateTime @default(now())

  session OmniSearchContentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([savedAt])
  @@index([sessionId, versionNumber])
}

// ============================================
// AI — Usage log, Nova conversations & messages
// ============================================

model AiUsageLog {
  id        String   @id @default(uuid())
  model     String   @db.VarChar(100)
  feature   String   @db.VarChar(100)
  userId    String?
  clientId  String?
  tokensIn  Int      @default(0)
  tokensOut Int      @default(0)
  latencyMs Int      @default(0)
  success   Boolean  @default(true)
  errorCode String?  @db.VarChar(20)
  createdAt DateTime @default(now())

  @@index([feature, createdAt])
  @@index([userId])
  @@index([createdAt])
  @@map("aiusagelog")
}

model NovaConversation {
  id            String   @id @default(uuid())
  userId        String
  clientId      String?
  title         String   @default("New conversation") @db.VarChar(255)
  summary       String?  @db.LongText
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  messages NovaMessage[]

  @@index([userId, lastMessageAt])
  @@index([clientId])
  @@map("novaconversation")
}

model NovaMessage {
  id             String   @id @default(uuid())
  conversationId String
  role           String   @db.VarChar(20) // 'user' | 'assistant'
  content        String   @db.LongText
  audioUrl       String?  @db.VarChar(500)
  model          String?  @db.VarChar(100)
  tokensIn       Int?
  tokensOut      Int?
  createdAt      DateTime @default(now())

  conversation NovaConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("novamessage")
}

// ============================================
// Backlinks Hub
// ============================================

enum BacklinkPlacementType {
  GUEST_POST
  PROFILE
}

enum BacklinkTargetType {
  PAGE
  DOMAIN
}

enum BacklinkOrderStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  IN_PROGRESS
  COMPLETED
  REJECTED
  CANCELLED
}

enum BacklinkOrderItemStatus {
  PENDING
  IN_PROGRESS
  LIVE
  REPLACED
  CANCELLED
}

/// Purchasable backlink inventory. Prices are always absolute USD; the catalog
/// deliberately stores no supplier, cost or source-currency information.
model BacklinkSite {
  id             String                @id @default(uuid())
  domain         String                @unique @db.VarChar(255)
  url            String                @db.VarChar(500)
  da             Int                   @default(0)
  dr             Int                   @default(0)
  monthlyTraffic Int                   @default(0)
  priceUsd       Decimal               @db.Decimal(10, 2)
  /// Blended authority-per-dollar ranking, recomputed on every write so the
  /// catalog can be sorted by value without a table scan.
  valueScore     Decimal               @default(0) @db.Decimal(10, 2)
  dofollowLinks  Int                   @default(1)
  placementType  BacklinkPlacementType @default(GUEST_POST)
  category       String?               @db.VarChar(100)
  country        String?               @db.VarChar(100)
  language       String?               @db.VarChar(100)
  turnaroundDays Int?
  sampleUrl      String?               @db.VarChar(500)
  isActive       Boolean               @default(true)
  isFeatured     Boolean               @default(false)
  tags           Json?
  /// Admin-only. Never serialized to client responses.
  internalNotes  String?               @db.LongText
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @default(now()) @updatedAt

  cartItems  BacklinkCartItem[]
  orderItems BacklinkOrderItem[]

  @@index([isActive, valueScore])
  @@index([isActive, priceUsd])
  @@index([isActive, da])
  @@map("backlinksite")
}

model BacklinkCartItem {
  id             String             @id @default(uuid())
  clientId       String
  backlinkSiteId String
  projectId      String?
  targetType     BacklinkTargetType @default(DOMAIN)
  wpPageId       String?
  targetUrl      String?            @db.VarChar(500)
  anchorText     String?            @db.VarChar(255)
  notes          String?            @db.LongText
  /// Price captured when added, so a mid-session catalog edit cannot silently
  /// change what the client thought they were buying.
  unitPriceUsd   Decimal            @db.Decimal(10, 2)
  addedById      String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @default(now()) @updatedAt

  client  ClientAccount @relation(fields: [clientId], references: [id], onDelete: Cascade)
  site    BacklinkSite  @relation(fields: [backlinkSiteId], references: [id], onDelete: Cascade)
  project Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  wpPage  WpPage?       @relation(fields: [wpPageId], references: [id], onDelete: SetNull)
  addedBy User?         @relation("BacklinkCartAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  @@unique([clientId, backlinkSiteId, wpPageId])
  @@index([clientId])
  @@map("backlinkcartitem")
}

model BacklinkOrder {
  id            String              @id @default(uuid())
  orderNumber   String              @unique @db.VarChar(30)
  clientId      String
  status        BacklinkOrderStatus @default(PENDING_REVIEW)
  subtotalUsd   Decimal             @db.Decimal(10, 2)
  totalUsd      Decimal             @db.Decimal(10, 2)
  itemCount     Int                 @default(0)
  /// Reserved for a future payment gateway; fulfilment does not depend on it.
  paymentStatus String              @default("UNPAID") @db.VarChar(30)
  requestedById String?
  clientNotes   String?             @db.LongText
  adminNotes    String?             @db.LongText
  submittedAt   DateTime            @default(now())
  approvedAt    DateTime?
  completedAt   DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @default(now()) @updatedAt

  client      ClientAccount        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  requestedBy User?                @relation("BacklinkOrderRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  items       BacklinkOrderItem[]
  events      BacklinkOrderEvent[]

  @@index([clientId, status])
  @@index([status, submittedAt])
  @@map("backlinkorder")
}

/// Snapshots domain and metrics at purchase time so later catalog edits never
/// rewrite the history of an order.
model BacklinkOrderItem {
  id              String                  @id @default(uuid())
  orderId         String
  backlinkSiteId  String?
  domainSnapshot  String                  @db.VarChar(255)
  daSnapshot      Int                     @default(0)
  drSnapshot      Int                     @default(0)
  trafficSnapshot Int                     @default(0)
  unitPriceUsd    Decimal                 @db.Decimal(10, 2)
  dofollowLinks   Int                     @default(1)
  placementType   BacklinkPlacementType   @default(GUEST_POST)
  projectId       String?
  targetType      BacklinkTargetType      @default(DOMAIN)
  wpPageId        String?
  targetUrl       String?                 @db.VarChar(500)
  anchorText      String?                 @db.VarChar(255)
  notes           String?                 @db.LongText
  status          BacklinkOrderItemStatus @default(PENDING)
  liveUrl         String?                 @db.VarChar(500)
  publishedAt     DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @default(now()) @updatedAt

  order   BacklinkOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  site    BacklinkSite? @relation(fields: [backlinkSiteId], references: [id], onDelete: SetNull)
  project Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  wpPage  WpPage?       @relation(fields: [wpPageId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([status])
  @@map("backlinkorderitem")
}

model BacklinkOrderEvent {
  id         String   @id @default(uuid())
  orderId    String
  actorId    String?
  eventType  String   @db.VarChar(50)
  fromStatus String?  @db.VarChar(30)
  toStatus   String?  @db.VarChar(30)
  note       String?  @db.VarChar(1000)
  metadata   Json?
  createdAt  DateTime @default(now())

  order BacklinkOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor User?         @relation("BacklinkOrderEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@map("backlinkorderevent")
}
