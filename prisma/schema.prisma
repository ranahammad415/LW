enum ReportStatus {
  DRAFT
  PM_REVIEW
  DELIVERED
}

model MonthlyReport {
  id             String       @id @default(uuid())
  clientId       String
  month          Int
  year           Int
  status         ReportStatus @default(DRAFT)
  aiContent      Json?
  workCycleId    String?
  pdfStoredPath  String?      @db.VarChar(500)
  pdfFileName    String?      @db.VarChar(255)
  pdfFileSize    Int?
  pdfGeneratedAt DateTime?
  createdAt      DateTime     @default(now())

  client    ClientAccount @relation(fields: [clientId], references: [id], onDelete: Cascade)
  workCycle WorkCycle?    @relation(fields: [workCycleId], references: [id], onDelete: SetNull)

  @@unique([clientId, month, year])
  @@index([workCycleId])
  @@map("monthlyreport")
}

// ── Monthly work session (agency-wide cycle) ──────────────────────────────
// A single OPEN row is the "current month" every portal focuses on. Opening the
// next cycle closes the current one, carries incomplete tasks forward, and
// triggers per-client report drafts + frozen analytics snapshots.
enum WorkCycleStatus {
  OPEN
  CLOSED
}

model WorkCycle {
  id         String          @id @default(uuid())
  month      Int
  year       Int
  status     WorkCycleStatus @default(OPEN)
  label      String?         @db.VarChar(100)
  openedAt   DateTime        @default(now())
  closedAt   DateTime?
  openedById String?

  openedBy        User?                        @relation("WorkCycleOpener", fields: [openedById], references: [id])
  tasks           Task[]
  reports         MonthlyReport[]
  snapshots       WorkCycleAnalyticsSnapshot[]
  contentMapNodes ContentMapNode[]

  @@unique([month, year])
  @@index([status])
  @@map("workcycle")
}

// Frozen analytics figures for a client at the moment a cycle is closed, so that
// browsing a past month shows the numbers as they were then.
model WorkCycleAnalyticsSnapshot {
  id          String   @id @default(uuid())
  workCycleId String
  clientId    String
  data        Json
  createdAt   DateTime @default(now())

  workCycle WorkCycle     @relation(fields: [workCycleId], references: [id], onDelete: Cascade)
  client    ClientAccount @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([workCycleId, clientId])
  @@map("workcycleanalyticssnapshot")
}

